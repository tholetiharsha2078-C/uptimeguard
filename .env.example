# Local-only overrides for `wrangler dev` / `vite`.
# Copy this file to `.dev.vars` (gitignored) before running the API locally.
# Never commit real secrets.

# development | production
ENVIRONMENT=development

# Optional: set to `1` to disable API rate limits while testing locally.
# Never enable in production.
DEMO_MODE=0

# Reserved for Phase 6 email alerts. Leave empty to keep notifications in-app.
# RESEND_API_KEY=
# ALERT_FROM_EMAIL=alerts@example.com
